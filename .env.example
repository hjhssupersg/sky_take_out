# Spring profile
SPRING_PROFILES_ACTIVE=dev

# MySQL
SKY_DB_HOST=localhost
SKY_DB_PORT=3306
SKY_DB_NAME=sky_take_out
SKY_DB_USERNAME=root
SKY_DB_PASSWORD=replace-me

# Redis
SKY_REDIS_HOST=localhost
SKY_REDIS_PORT=6379
SKY_REDIS_DATABASE=0

# JWT: use long, random, different values in each environment
SKY_JWT_ADMIN_SECRET=replace-with-a-random-admin-secret
SKY_JWT_USER_SECRET=replace-with-a-random-user-secret

# Initial password assigned when an administrator creates an employee
SKY_EMPLOYEE_DEFAULT_PASSWORD=replace-with-a-strong-temporary-password

# Aliyun OSS
SKY_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
SKY_OSS_ACCESS_KEY_ID=replace-me
SKY_OSS_ACCESS_KEY_SECRET=replace-me
SKY_OSS_BUCKET_NAME=replace-me

# WeChat mini program
SKY_WECHAT_APPID=replace-me
SKY_WECHAT_SECRET=replace-me
